:global(.game-page) {
      position: relative;
      min-height: 100vh;
      overflow: hidden;
      padding: 28px 30px 22px;
      background: radial-gradient(ellipse at 52% 10%, #fffdf7 0, #f8f6ef 50%, #efede4 100%);
}

:global(.page-glow) {
      position: absolute;
      top: -320px;
      left: 50%;
      width: 900px;
      height: 520px;
      border-radius: 50%;
      background: rgba(222, 201, 150, .12);
      filter: blur(36px);
      transform: translateX(-50%);
      pointer-events: none;
}

:global(.game-layout) {
      position: relative;
      width: min(100%, 1280px);
      margin: 0 auto;
}

:global(.topbar) {
      height: 60px;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
}

:global(.brand) {
      display: flex;
      align-items: center;
      gap: 11px;
      color: var(--ink);
      text-decoration: none;
}

:global(.brand-mark) {
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      border: 1px solid #ded5bc;
      border-radius: 13px;
      background: #f2ecd9;
      color: #8b7247;
      font-family: Georgia, serif;
      font-size: 24px;
}

:global(.brand) strong, :global(.brand) small {
      display: block;
}

:global(.brand) strong {
      font-family: "Noto Serif KR", serif;
      font-size: 16px;
      letter-spacing: -.04em;
}

:global(.brand) small {
      margin-top: 3px;
      color: #a3a297;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: .17em;
}

:global(.top-actions) {
      display: flex;
      align-items: center;
      gap: 12px;
}

:global(.season-pill) {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid #e8e4d8;
      border-radius: 20px;
      background: rgba(255,255,255,.55);
      color: #8c9185;
      font-size: 11px;
      font-weight: 700;
}

:global(.season-pill) i {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #7da072;
      box-shadow: 0 0 0 3px #e8f0e3;
}

:global(.icon-button) {
      width: 34px;
      height: 34px;
      border: 1px solid #e8e4d8;
      border-radius: 11px;
      background: rgba(255,255,255,.65);
      color: #71806e;
      font-size: 20px;
      cursor: pointer;
}

:global(.intro-row) {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin: 13px 0 23px;
}

:global(.eyebrow) {
      margin: 0 0 8px;
      color: #a08757;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .2em;
}

h1, h2, p {
      margin-top: 0;
}

h1 {
      margin-bottom: 8px;
      font-family: "Noto Serif KR", serif;
      font-size: clamp(34px, 4.1vw, 48px);
      font-weight: 700;
      line-height: 1.23;
      letter-spacing: -.08em;
}

:global(.mobile-break) {
      display: none;
}

:global(.lead) {
      margin: 0;
      color: #838a7f;
      font-size: 13px;
}

:global(.day-card) {
      min-width: 130px;
      padding: 12px 16px 11px;
      border: 1px solid #e9e5d9;
      border-radius: 16px;
      background: rgba(255,255,255,.55);
      text-align: right;
}

:global(.day-card) span, :global(.day-card) small {
      display: block;
      color: #999b90;
      font-size: 10px;
      font-weight: 600;
}

:global(.day-card) strong {
      display: block;
      margin: 3px 0;
      font-family: "Noto Serif KR", serif;
      font-size: 20px;
}

:global(.metrics) {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1.08fr;
      gap: 12px;
      margin-bottom: 16px;
}

:global(.metric-card) {
      position: relative;
      min-height: 91px;
      padding: 15px 16px 12px 47px;
      border: 1px solid #e9e6dc;
      border-radius: 16px;
      background: rgba(255,255,255,.75);
}

:global(.metric-icon) {
      position: absolute;
      top: 15px;
      left: 16px;
      display: grid;
      width: 22px;
      height: 22px;
      place-items: center;
      border-radius: 8px;
      font-size: 15px;
}

:global(.metric-icon):global(.gold) {
      background: #f5edd9;
      color: #b28e50;
}

:global(.metric-icon):global(.blue) {
      background: #e7eee8;
      color: #5d7e69;
}

:global(.metric-icon):global(.red) {
      background: #f5e8e3;
      color: #a8645b;
}

:global(.metric-label) {
      display: block;
      color: #8f9489;
      font-size: 10px;
      font-weight: 700;
}

:global(.metric-card) strong {
      display: block;
      margin-top: 1px;
      font-size: 22px;
      letter-spacing: -.05em;
}

:global(.metric-card) strong small {
      color: #9a9b90;
      font-size: 11px;
      font-weight: 600;
}

:global(.metric-card) em {
      display: block;
      margin-top: 2px;
      color: #a0a195;
      font-size: 9px;
      font-style: normal;
}

:global(.end-turn) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 18px;
      border: 1px solid #4c6b49;
      border-radius: 16px;
      background: #597750;
      color: #fffdf5;
      text-align: left;
      cursor: pointer;
      box-shadow: 0 4px 0 #405e3b;
      transition: transform .15s, box-shadow .15s;
}

:global(.end-turn):hover {
      transform: translateY(-1px);
      box-shadow: 0 5px 0 #405e3b;
}

:global(.end-turn):active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 #405e3b;
}

:global(.end-turn):disabled {
      opacity: .55;
      cursor: default;
}

:global(.end-turn) span {
      color: #d9e0cf;
      font-size: 10px;
      font-weight: 700;
}

:global(.end-turn) strong {
      font-size: 14px;
}

:global(.end-turn) b {
      margin-left: 7px;
      font-size: 18px;
}

:global(.play-grid) {
      display: grid;
      grid-template-columns: minmax(0, 1.72fr) minmax(280px, .82fr);
      gap: 15px;
      align-items: stretch;
}

:global(.map-card), :global(.command-card), :global(.log-card) {
      border: 1px solid #e8e5da;
      border-radius: 19px;
      background: rgba(255,255,255,.78);
      box-shadow: 0 8px 25px rgba(57,63,48,.025);
}

:global(.map-card) {
      padding: 18px 19px 13px;
}

:global(.map-heading) {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin: 0 2px 13px;
}

:global(.map-heading) :global(.eyebrow) {
      margin-bottom: 4px;
      font-size: 8px;
}

:global(.map-heading) h2 {
      margin: 0;
      font-family: "Noto Serif KR", serif;
      font-size: 19px;
      letter-spacing: -.06em;
}

:global(.map-coord) {
      padding: 5px 8px;
      border: 1px solid #efede7;
      border-radius: 7px;
      color: #a0a195;
      font: 700 9px ui-monospace, monospace;
}

:global(.map-frame) {
      position: relative;
      padding: 17px 19px 16px;
      overflow: hidden;
      border: 1px solid #d8d3bd;
      border-radius: 15px;
      background-color: #e3dfc8;
      background-image: radial-gradient(ellipse at 20% 20%, rgba(255,255,255,.35), transparent 42%), repeating-linear-gradient(32deg, rgba(113,133,99,.055) 0 1px, transparent 1px 10px);
      box-shadow: inset 0 1px 8px rgba(61,71,48,.1);
}

:global(.map-grid) {
      display: grid;
      grid-template-columns: repeat(15, minmax(0, 1fr));
      gap: 3px;
      width: 100%;
      aspect-ratio: 15 / 9;
}

:global(.tile) {
      position: relative;
      display: grid;
      min-width: 0;
      place-items: center;
      padding: 0;
      overflow: visible;
      border: 1px solid rgba(110,111,83,.11);
      border-radius: 4px;
      background: #d6d8ba;
      color: #fff;
      cursor: pointer;
      transition: filter .12s, transform .12s, box-shadow .12s;
}

:global(.tile):nth-child(3n) {
      background-color: #d1d7b5;
}

:global(.tile):nth-child(7n) {
      background-color: #d9d6b2;
}

:global(.tile):hover {
      z-index: 2;
      filter: brightness(1.1);
      transform: scale(1.07);
}

:global(.tile):global(.blue) {
      background-color: #799280;
      border-color: rgba(45,80,63,.2);
}

:global(.tile):global(.blue):nth-child(odd) {
      background-color: #829b88;
}

:global(.tile):global(.red) {
      background-color: #ad8172;
      border-color: rgba(91,51,49,.2);
}

:global(.tile):global(.red):nth-child(even) {
      background-color: #b58b78;
}

:global(.tile):global(.forest):not(:global(.blue)):not(:global(.red)) {
      background-color: #bfca9b;
}

:global(.tile):global(.hill):not(:global(.blue)):not(:global(.red)) {
      background-color: #d4cba9;
}

:global(.tile):global(.town):not(:global(.blue)):not(:global(.red)) {
      background-color: #d4c69d;
}

:global(.tile):global(.blue):global(.forest), :global(.tile):global(.blue):global(.hill), :global(.tile):global(.blue):global(.town) {
      background-color: #799280;
}

:global(.tile):global(.red):global(.forest), :global(.tile):global(.red):global(.hill), :global(.tile):global(.red):global(.town) {
      background-color: #ad8172;
}

:global(.tile):global(.capital):global(.blue) {
      background: #456d5a;
      border: 2px solid #d6c18d;
}

:global(.tile):global(.capital):global(.red) {
      background: #934f49;
      border: 2px solid #e1c39b;
}

:global(.tile):global(.selected) {
      z-index: 3;
      outline: 2px solid #f6dc8c;
      outline-offset: 1px;
      box-shadow: 0 0 0 4px rgba(246,220,140,.35);
}

:global(.tile):global(.target) {
      outline: 1px dashed #fff7d7;
      outline-offset: -3px;
}

:global(.tile-art) {
      position: absolute;
      top: 50%;
      left: 50%;
      font-size: clamp(10px, 1.4vw, 17px);
      line-height: 1;
      transform: translate(-50%, -55%);
      filter: drop-shadow(0 1px 1px rgba(40,48,39,.25));
}

:global(.capital-label) {
      position: absolute;
      bottom: 2px;
      left: 0;
      width: 100%;
      color: #fff7e8;
      font-size: clamp(4px, .55vw, 7px);
      font-weight: 800;
      text-align: center;
      white-space: nowrap;
}

:global(.troop-count) {
      position: absolute;
      right: -3px;
      bottom: -4px;
      z-index: 2;
      display: grid;
      min-width: 13px;
      height: 13px;
      place-items: center;
      padding: 0 3px;
      border: 1px solid rgba(255,255,255,.75);
      border-radius: 10px;
      background: #f7f3e8;
      color: #354238;
      font: 800 8px ui-monospace, monospace;
      box-shadow: 0 1px 2px rgba(0,0,0,.14);
}

:global(.target-dot) {
      position: absolute;
      top: 3px;
      right: 4px;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #fff2b1;
      box-shadow: 0 0 0 2px rgba(255,242,177,.24);
}

:global(.compass) {
      position: absolute;
      top: 4px;
      left: 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: -2px;
      color: #8b835f;
      font-family: Georgia, serif;
      font-size: 10px;
      line-height: 1;
      opacity: .8;
}

:global(.compass) span {
      font: 800 7px "DM Sans", sans-serif;
}

:global(.map-stamp) {
      position: absolute;
      right: 5px;
      bottom: 3px;
      color: rgba(113,106,77,.48);
      font: 800 6px/1.1 ui-monospace, monospace;
      letter-spacing: .15em;
      transform: rotate(-8deg);
}

:global(.map-legend) {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      padding: 12px 2px 0;
      color: #8e9487;
      font-size: 9px;
      font-weight: 600;
}

:global(.map-legend) span {
      display: inline-flex;
      align-items: center;
      gap: 5px;
}

:global(.legend-dot) {
      width: 8px;
      height: 8px;
      border-radius: 3px;
}

:global(.blue-dot) {
      background: #688572;
}

:global(.red-dot) {
      background: #aa7267;
}

:global(.neutral-dot) {
      background: #d1d5b3;
      border: 1px solid #bcc49e;
}

:global(.map-legend) b {
      font-size: 10px;
}

:global(.side-column) {
      display: flex;
      flex-direction: column;
      gap: 12px;
}

:global(.command-card) {
      padding: 16px;
}

:global(.side-title) {
      display: flex;
      align-items: center;
      gap: 10px;
}

:global(.side-icon) {
      display: grid;
      width: 32px;
      height: 32px;
      place-items: center;
      border-radius: 11px;
      background: #f4ead8;
      color: #a07e47;
      font-size: 16px;
}

:global(.side-title) :global(.eyebrow) {
      margin-bottom: 2px;
      font-size: 8px;
}

:global(.side-title) h2, :global(.log-heading) h2 {
      margin: 0;
      font-family: "Noto Serif KR", serif;
      font-size: 16px;
      letter-spacing: -.05em;
}

:global(.selected-box) {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-top: 16px;
      padding: 11px;
      border: 1px solid #eeece5;
      border-radius: 12px;
      background: #faf9f4;
}

:global(.selected-mark) {
      display: grid;
      width: 31px;
      height: 31px;
      place-items: center;
      border-radius: 9px;
      background: #e9efe7;
      color: #608069;
      font-size: 14px;
}

:global(.selected-box) small {
      display: block;
      color: #9b9d92;
      font-size: 9px;
}

:global(.selected-box) strong {
      display: block;
      margin-top: 2px;
      font-size: 12px;
}

:global(.selected-power) {
      margin-left: auto;
      color: #70826e;
      font-size: 10px;
      font-weight: 800;
}

:global(.command-message) {
      min-height: 46px;
      margin: 11px 1px 10px;
      color: #7f877b;
      font-size: 11px;
      line-height: 1.55;
}

:global(.command-buttons) {
      display: flex;
      align-items: center;
      gap: 10px;
}

:global(.recruit-button) {
      display: flex;
      flex: 1;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      min-height: 37px;
      padding: 0 11px;
      border: 1px solid #e2e5da;
      border-radius: 10px;
      background: #edf1e9;
      color: #4f694e;
      font-size: 10px;
      font-weight: 800;
      cursor: pointer;
}

:global(.recruit-button):disabled {
      opacity: .55;
      cursor: default;
}

:global(.recruit-button) span {
      color: #87937e;
      font-size: 9px;
}

:global(.command-hint) {
      display: flex;
      flex-direction: column;
      gap: 3px;
      color: #9b9c90;
      font-size: 8px;
      white-space: nowrap;
}

:global(.command-hint) b {
      color: #7b8276;
      font-size: 9px;
}

:global(.log-card) {
      flex: 1;
      padding: 15px 16px 11px;
}

:global(.log-heading) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 10px;
      border-bottom: 1px solid #f0eee8;
}

:global(.log-heading) h2 {
      font-size: 14px;
}

:global(.log-heading) span {
      color: #a1a195;
      font-size: 9px;
}

:global(.log-card) ul {
      display: flex;
      flex-direction: column;
      gap: 11px;
      margin: 11px 0 0;
      padding: 0;
      list-style: none;
}

:global(.log-card) li {
      display: flex;
      gap: 9px;
}

:global(.log-marker) {
      width: 6px;
      height: 6px;
      flex: 0 0 6px;
      margin-top: 4px;
      border-radius: 50%;
      background: #c4a66c;
      box-shadow: 0 0 0 3px #f5efdf;
}

:global(.log-marker):global(.good) {
      background: #6d9272;
      box-shadow: 0 0 0 3px #e8f0e8;
}

:global(.log-marker):global(.bad) {
      background: #b86e60;
      box-shadow: 0 0 0 3px #f5e9e4;
}

:global(.log-card) li small {
      display: block;
      color: #aaa99d;
      font-size: 8px;
}

:global(.log-card) li p {
      margin: 2px 0 0;
      color: #727d70;
      font-size: 9px;
      line-height: 1.4;
}

:global(.tip-card) {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      padding: 10px 12px;
      border: 1px solid #ebe4d2;
      border-radius: 12px;
      background: #f5f0e2;
      color: #867c62;
}

:global(.tip-card) > span {
      color: #b2955f;
      font-size: 16px;
}

:global(.tip-card) p {
      margin: 0;
      font-size: 9px;
      line-height: 1.55;
}

:global(.tip-card) strong {
      color: #70684f;
      font-size: 10px;
}

:global(.game-footer) {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 18px;
      color: #a4a497;
      font-size: 9px;
}

:global(.game-footer) i {
      margin: 0 5px;
      color: #c6b789;
      font-style: normal;
}

:global(.game-footer) button {
      padding: 0;
      border: 0;
      background: none;
      color: #74826f;
      font-size: 9px;
      font-weight: 800;
      cursor: pointer;
}

:global(.result-backdrop) {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(35,48,39,.42);
      backdrop-filter: blur(6px);
}

:global(.result-modal) {
      width: min(100%, 380px);
      padding: 34px 30px 29px;
      border: 1px solid #e5decd;
      border-radius: 22px;
      background: #fffdf7;
      text-align: center;
      box-shadow: 0 24px 70px rgba(30,42,32,.25);
}

:global(.result-modal) > span {
      display: inline-grid;
      width: 57px;
      height: 57px;
      place-items: center;
      margin-bottom: 16px;
      border-radius: 18px;
      background: #f3ecd8;
      color: #a4864f;
      font: 34px Georgia, serif;
}

:global(.result-modal) > :global(.crown-lose) {
      background: #f3e7e3;
      color: #a9645a;
}

:global(.result-modal) :global(.eyebrow) {
      margin-bottom: 6px;
}

:global(.result-modal) h2 {
      margin-bottom: 8px;
      font-family: "Noto Serif KR", serif;
      font-size: 24px;
      letter-spacing: -.06em;
}

:global(.result-modal) p:not(:global(.eyebrow)) {
      color: #858c80;
      font-size: 12px;
}

:global(.modal-button) {
      min-height: 43px;
      margin-top: 9px;
      padding: 0 20px;
      border: 0;
      border-radius: 12px;
      background: #597750;
      color: white;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
}

@media (max-width: 900px) {
      :global(.game-page) {
            padding: 22px 18px;
      }

      :global(.play-grid) {
            grid-template-columns: minmax(0, 1.5fr) minmax(250px, .9fr);
            gap: 11px;
      }

      :global(.map-card) {
            padding: 15px 13px 12px;
      }

      :global(.map-frame) {
            padding: 17px 12px 16px;
      }

      :global(.map-grid) {
            gap: 2px;
      }

      :global(.map-legend) {
            gap: 10px;
      }

      :global(.command-card), :global(.log-card) {
            padding: 13px;
      }

      :global(.command-buttons) {
            align-items: stretch;
            flex-direction: column;
      }

      :global(.command-hint) {
            flex-direction: row;
            justify-content: space-between;
      }

}

@media (max-width: 680px) {
      :global(.game-page) {
            padding: 17px 12px;
      }

      :global(.topbar) {
            height: 52px;
      }

      :global(.brand-mark) {
            width: 34px;
            height: 34px;
      }

      :global(.brand) strong {
            font-size: 14px;
      }

      :global(.season-pill) {
            padding: 7px 9px;
            font-size: 9px;
      }

      :global(.intro-row) {
            align-items: center;
            margin: 15px 0 16px;
      }

      h1 {
            font-size: 35px;
      }

      :global(.mobile-break) {
            display: block;
      }

      :global(.lead) {
            max-width: 230px;
            font-size: 11px;
            line-height: 1.5;
      }

      :global(.day-card) {
            min-width: 90px;
            padding: 10px 11px;
      }

      :global(.day-card) strong {
            font-size: 17px;
      }

      :global(.metrics) {
            grid-template-columns: repeat(3, 1fr);
            gap: 7px;
            margin-bottom: 10px;
      }

      :global(.metric-card) {
            min-height: 76px;
            padding: 11px 7px 8px 31px;
            border-radius: 12px;
      }

      :global(.metric-icon) {
            top: 11px;
            left: 8px;
            width: 18px;
            height: 18px;
            font-size: 11px;
      }

      :global(.metric-label) {
            font-size: 8px;
      }

      :global(.metric-card) strong {
            margin-top: 2px;
            font-size: 18px;
      }

      :global(.metric-card) strong small {
            font-size: 9px;
      }

      :global(.metric-card) em {
            font-size: 7px;
      }

      :global(.end-turn) {
            grid-column: 1 / -1;
            min-height: 46px;
            padding: 9px 14px;
      }

      :global(.play-grid) {
            grid-template-columns: 1fr;
      }

      :global(.map-card) {
            padding: 13px 10px 11px;
            border-radius: 15px;
      }

      :global(.map-heading) {
            margin-bottom: 10px;
      }

      :global(.map-heading) h2 {
            font-size: 16px;
      }

      :global(.map-frame) {
            padding: 14px 8px 13px;
            border-radius: 11px;
      }

      :global(.map-grid) {
            gap: 2px;
      }

      :global(.tile) {
            border-radius: 3px;
      }

      :global(.tile-art) {
            font-size: clamp(9px, 3vw, 15px);
      }

      :global(.capital-label) {
            bottom: 1px;
            font-size: 5px;
      }

      :global(.troop-count) {
            min-width: 11px;
            height: 11px;
            right: -2px;
            bottom: -3px;
            font-size: 7px;
      }

      :global(.map-legend) {
            gap: 9px;
            padding-top: 10px;
            font-size: 8px;
      }

      :global(.map-legend) span:nth-last-child(-n + 2) {
            display: none;
      }

      :global(.side-column) {
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: stretch;
            gap: 9px;
      }

      :global(.command-card) {
            grid-column: 1 / -1;
      }

      :global(.command-buttons) {
            flex-direction: row;
      }

      :global(.command-hint) {
            flex-direction: column;
      }

      :global(.log-card) {
            min-height: 166px;
      }

      :global(.log-card) ul {
            gap: 8px;
      }

      :global(.tip-card) {
            align-items: center;
            min-height: 100%;
            padding: 10px;
      }

      :global(.tip-card) p {
            font-size: 8px;
      }

      :global(.game-footer) {
            margin-top: 13px;
      }

}